#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn ;;init forms
  (ros:ensure-asdf)
  (require :sb-posix)
  (require :sb-cover)
  #+quicklisp (ql:quickload '(:rove) :silent t))

(defpackage :ros.script.coverage
  (:use :cl))
(in-package :ros.script.coverage)

;;; cl-mcp のテストカバレッジを sb-cover で実測するドライバ。
;;;
;;; 使い方（リポジトリのルートから実行する）:
;;;   ./scripts/coverage.ros --smoke   既知の答えで計測パイプラインを検算する（約2分）
;;;   ./scripts/coverage.ros           全スイートを計装実行する（12〜18分）
;;;
;;; ワーカー子プロセス内の実行は計測できない。盲点は scripts/coverage-scope.md を見ること。

(defun repo-root ()
  "カレントディレクトリをリポジトリのルートとして返す。ルートでなければエラーにする。"
  (let ((cwd (uiop:getcwd)))
    (unless (probe-file (merge-pathnames "cl-mcp.asd" cwd))
      (error "cl-mcp.asd が見つからない。リポジトリのルートから実行すること（現在: ~A）" cwd))
    cwd))

(defun setup-isolated-cache (root)
  "計装済み fasl を専用ディレクトリに隔離し、そのディレクトリを返す。

環境変数も設定するのは、ワーカー子プロセスが親の環境を引き継いで同じキャッシュを
読むようにするためである。ワーカー側のカバレッジは捨てるので数値には影響しないが、
通常のキャッシュを計装済み fasl で汚さないことが目的である。"
  (let ((cache (merge-pathnames "coverage/cache/" root)))
    (ensure-directories-exist cache)
    (sb-posix:putenv (format nil "ASDF_OUTPUT_TRANSLATIONS=/:~A" (namestring cache)))
    (asdf:initialize-output-translations)
    cache))

(define-condition coverage-adapter-error (error)
  ((detail :initarg :detail :reader coverage-adapter-error-detail))
  (:report
   (lambda (condition stream)
     (format stream
             "sb-cover の内部 API が期待と違う形をしている: ~A~@
              SBCL ~A。scripts/coverage.ros のアダプタを見直すこと。~@
              カバレッジ 0% を黙って返すより、ここで止まる方がよい。"
             (coverage-adapter-error-detail condition)
             (lisp-implementation-version)))))

(defun coverage-table ()
  "計装済みファイルのカバレッジ記録を持つハッシュ表を返す。"
  (let ((table (car sb-int:*code-coverage-info*)))
    (unless (hash-table-p table)
      (error 'coverage-adapter-error
             :detail "(car sb-int:*code-coverage-info*) がハッシュ表ではない"))
    table))

(defun collect-file-coverage (file)
  "FILE の (式ok 式all 分岐ok 分岐all) を返す。

sb-cover は HTML しか出さないので、HTML を書き出す関数に空ストリームを渡して
数値だけを取り出す。sb-cover 自身の集計ロジックを再利用するため、ここで得た数値は
HTML レポートの数字と必ず一致する。"
  (handler-case
      (let ((counts (sb-cover::report-file file (make-broadcast-stream) :default)))
        (unless (and (listp counts) (= 2 (length counts)))
          (error 'coverage-adapter-error
                 :detail (format nil "report-file が 2 要素のリストを返さなかった: ~S" counts)))
        (destructuring-bind (expression branch) counts
          (unless (and (eq (sb-cover::mode-of expression) :expression)
                       (eq (sb-cover::mode-of branch) :branch))
            (error 'coverage-adapter-error
                   :detail (format nil "report-file の要素が式/分岐の順で並んでいない（mode: ~S ~S）"
                                   (sb-cover::mode-of expression) (sb-cover::mode-of branch))))
          (list (sb-cover::ok-of expression) (sb-cover::all-of expression)
                (sb-cover::ok-of branch) (sb-cover::all-of branch))))
    (coverage-adapter-error (e) (error e))
    (error (e)
      (error 'coverage-adapter-error
             :detail (format nil "sb-cover 内部 API 呼び出しで予期しないエラー: ~A" e)))))

(defun run-smoke (root)
  "src/utils/strings.lisp だけを計装し、既知の答えと突き合わせる。

期待値 (21 21 4 4) は 2026-08-01 に SBCL 2.5.8 で実測した値であり、
sb-cover の HTML レポートが出す数字と一致することを確認済みである。"
  (proclaim '(optimize sb-cover:store-coverage-data))
  (asdf:load-system :cl-mcp/src/utils/strings :force t)
  (proclaim '(optimize (sb-cover:store-coverage-data 0)))
  (asdf:load-system :cl-mcp/tests/utils-strings-test)
  (rove:run :cl-mcp/tests/utils-strings-test)
  ;; report がカバレッジ記録を最新化するので、集計より先に呼ぶ必要がある。
  (sb-cover:report (merge-pathnames "coverage/smoke/" root))
  (let* ((file (namestring (truename (merge-pathnames "src/utils/strings.lisp" root))))
         (expected '(21 21 4 4))
         (actual (collect-file-coverage file)))
    (format t "~&~%smoke: ~A~%  expected ~S~%  actual   ~S~%" file expected actual)
    (cond ((equal actual expected)
           (format t "~&SMOKE OK~%")
           0)
          (t
           (format t "~&SMOKE FAILED~%")
           1))))

(defun main (&rest argv)
  (let* ((root (repo-root))
         (cache (setup-isolated-cache root)))
    (format t "~&repo-root: ~A~%cache:     ~A~%" root cache)
    (uiop:quit
     (cond ((member "--smoke" argv :test #'string=) (run-smoke root))
           (t (format t "~&full モードは未実装~%") 1)))))
